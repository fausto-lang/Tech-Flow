<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.overbyte.controllers.DashboardController"
      stylesheets="@../styles/main.css"
      prefWidth="1280" prefHeight="720">

    <VBox styleClass="sidebar" prefWidth="260" spacing="20">
        <padding>
            <Insets top="20" right="16" bottom="20" left="16"/>
        </padding>
        <Label text="Over-Byte" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        
        <VBox spacing="8">
            <Button text="Ventas &amp; Cajas" styleClass="button-primary" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="Inventario &amp; Stock" style="-fx-background-color: transparent; -fx-text-fill: #9ca3af;" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="Colaboradores" style="-fx-background-color: transparent; -fx-text-fill: #9ca3af;" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="Reportes Financieros" style="-fx-background-color: transparent; -fx-text-fill: #9ca3af;" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
        </VBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS" spacing="24">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
        
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="4">
                <Label text="Control de Cajas y Flujo de Ventas" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="🟢 TURNO MAÑANA EN CURSO   •   Sincronizado: hace 12s" style="-fx-text-fill: #14b8a6; -fx-font-size: 11px;"/>
            </VBox>
        </HBox>

        <VBox styleClass="card" prefHeight="90">
            <Label text="TOTAL VENTAS DEL DÍA" style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;"/>
            <Label text="4,850.50 BS" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
        </VBox>

        <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="12">
            <Label text="Historial de Ventas en Vivo" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            
            <TableView fx:id="tableVentas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colFolio" text="FOLIO TICKET" prefWidth="120" />
                    <TableColumn fx:id="colHora" text="HORA" prefWidth="120" />
                    <TableColumn fx:id="colTerminal" text="CAJA / TERMINAL" prefWidth="180" />
                    <TableColumn fx:id="colCajero" text="CAJERO ASIGNADO" prefWidth="180" />
                    <TableColumn fx:id="colMetodo" text="MÉTODO DE PAGO" prefWidth="150" />
                    <TableColumn fx:id="colTotal" text="TOTAL TRANSACCIÓN" prefWidth="150" />
                </columns>
            </TableView>
        </VBox>
    </VBox>
</HBox>