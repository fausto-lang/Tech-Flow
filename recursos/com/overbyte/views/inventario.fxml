<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.overbyte.controllers.InventoryController"
      stylesheets="@../styles/main.css"
      prefWidth="1280" prefHeight="720">

    <VBox styleClass="sidebar" prefWidth="260" spacing="20">
        <padding>
            <Insets top="20" right="16" bottom="20" left="16"/>
        </padding>
        <Label text="Over-Byte" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        
        <VBox spacing="8">
            <Button text="Ventas &amp; Cajas" style="-fx-background-color: transparent; -fx-text-fill: #9ca3af;" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="Inventario &amp; Stock" styleClass="button-primary" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="Colaboradores" style="-fx-background-color: transparent; -fx-text-fill: #9ca3af;" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
        </VBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS" spacing="24">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
        
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="Inventario &amp; Control de Stock" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>

        <VBox styleClass="card">
            <Label text="VALOR ALMACÉN (COSTO)" style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;"/>
            <Label text="$48,920.00 USD" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
        </VBox>

        <TableView fx:id="tableInventario" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colProducto" text="PRODUCTO &amp; IDENTIFICADOR" prefWidth="300" />
                <TableColumn fx:id="colCategoria" text="CATEGORÍA" prefWidth="180" />
                <TableColumn fx:id="colPrecioCosto" text="PRECIO / COSTO" prefWidth="180" />
                <TableColumn fx:id="colProveedor" text="PROVEEDOR" prefWidth="180" />
                <TableColumn fx:id="colEstado" text="ESTADO" prefWidth="150" />
            </columns>
        </TableView>
    </VBox>
</HBox>