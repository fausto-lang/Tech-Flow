<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.overbyte.controllers.EmployeesController"
      stylesheets="@../styles/main.css"
      prefWidth="1280" prefHeight="720">

    <VBox styleClass="sidebar" prefWidth="260" spacing="20">
        <padding>
            <Insets top="20" right="16" bottom="20" left="16"/>
        </padding>
        <Label text="Over-Byte" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        
        <VBox spacing="8">
            <Button text="Ventas &amp; Cajas" style="-fx-background-color: transparent; -fx-text-fill: #9ca3af;" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="Inventario &amp; Stock" style="-fx-background-color: transparent; -fx-text-fill: #9ca3af;" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            <Button text="Colaboradores" styleClass="button-primary" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
        </VBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS" spacing="24">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
        
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="Gestión de Colaboradores &amp; Empleados" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>

        <HBox spacing="16">
            <VBox styleClass="card" prefWidth="240">
                <Label text="TOTAL EMPLEADOS" style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;"/>
                <Label text="8" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            </VBox>
            <VBox styleClass="card" prefWidth="240">
                <Label text="CAJEROS / TERMINAL" style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;"/>
                <Label text="4" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>

        <TableView fx:id="tableEmpleados" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colColaborador" text="COLABORADOR / EMPLEADO" prefWidth="250" />
                <TableColumn fx:id="colRol" text="ROL EN SISTEMA" prefWidth="180" />
                <TableColumn fx:id="colArea" text="ÁREA O CAJA" prefWidth="180" />
                <TableColumn fx:id="colEstadoActual" text="ESTADO ACTUAL" prefWidth="150" />
                <TableColumn fx:id="colUltimoAcceso" text="ÚLTIMO ACCESO POS" prefWidth="150" />
            </columns>
        </TableView>
    </VBox>
</HBox>