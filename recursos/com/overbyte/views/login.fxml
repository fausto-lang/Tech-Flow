<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.overbyte.controllers.LoginController"
            stylesheets="@../styles/main.css"
            prefWidth="1280" prefHeight="720" styleClass="root">

    <VBox alignment="CENTER" maxWidth="450" spacing="24" styleClass="card">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <VBox alignment="CENTER" spacing="8">
            <Label text="Over-Byte" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Selecciona tu rol e ingresa tus credenciales" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
        </VBox>

        <VBox spacing="6" prefWidth="Infinity">
            <Label text="ID de Usuario" style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;"/>
            <TextField fx:id="txtUserId" text="EMP-9031" />
        </VBox>

        <VBox spacing="6" prefWidth="Infinity">
            <Label text="Rol del Colaborador" style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;"/>
            <HBox spacing="10">
                <Button text="Cajero" prefWidth="190" style="-fx-background-color: #111723; -fx-text-fill: white; -fx-border-color: #1e293b; -fx-border-radius: 8px; -fx-padding: 12px;" />
                <Button text="Almacén" prefWidth="190" style="-fx-background-color: #5850ec; -fx-text-fill: white; -fx-border-radius: 8px; -fx-padding: 12px;" />
            </HBox>
        </VBox>

        <VBox spacing="6" prefWidth="Infinity">
            <Label text="Contraseña" style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;"/>
            <PasswordField fx:id="txtPassword" text="password123" />
        </VBox>

        <Button text="Iniciar Turno / Entrar →" styleClass="button-primary" prefWidth="Infinity" onAction="#handleLogin" />
    </VBox>
</StackPane>