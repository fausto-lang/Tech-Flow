<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.overbyte.controllers.AlmacenController"
      spacing="0"
      stylesheets="@../styles/estilos.css"
      styleClass="fondo-login">

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <!-- ENCABEZADO -->
    <VBox alignment="CENTER_LEFT" spacing="6">
        <Label text="📦" styleClass="icono-logo"/>
        <Label text="ALMACÉN / INVENTARIO" styleClass="titulo"/>
        <Label text="Gestión de productos y existencias"
               styleClass="subtitulo"/>
    </VBox>

    <HBox spacing="16" alignment="TOP_LEFT" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">

        <!-- FORMULARIO IZQUIERDA -->
        <VBox alignment="TOP_LEFT" spacing="12"
              styleClass="tarjeta-login" VBox.vgrow="ALWAYS"
              HBox.hgrow="1">

            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>

            <Label text="Registrar producto" styleClass="titulo-formulario"/>
            <Label text="Producto nuevo o reabastecimiento"
                   styleClass="texto-secundario"/>

            <VBox spacing="8">
                <Label text="ID producto" styleClass="etiqueta"/>
                <TextField fx:id="campoId"
                           promptText="Ej: PROD-001"
                           styleClass="campo"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Nombre" styleClass="etiqueta"/>
                <TextField fx:id="campoNombre"
                           promptText="Nombre del producto"
                           styleClass="campo"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Marca" styleClass="etiqueta"/>
                <TextField fx:id="campoMarca"
                           promptText="Marca"
                           styleClass="campo"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Categoría" styleClass="etiqueta"/>
                <TextField fx:id="campoCategoria"
                           promptText="Categoría"
                           styleClass="campo"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Descripción" styleClass="etiqueta"/>
                <TextField fx:id="campoDescripcion"
                           promptText="Descripción"
                           styleClass="campo"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Precio entrada" styleClass="etiqueta"/>
                <TextField fx:id="campoPrecioEntrada"
                           promptText="0.00"
                           styleClass="campo"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Precio venta" styleClass="etiqueta"/>
                <TextField fx:id="campoPrecioVenta"
                           promptText="0.00"
                           styleClass="campo"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Stock inicial" styleClass="etiqueta"/>
                <TextField fx:id="campoStock"
                           promptText="0"
                           styleClass="campo"/>
            </VBox>

            <Button text="INGRESAR PRODUCTO NUEVO"
                    onAction="#ingresarProductoNuevo"
                    maxWidth="Infinity"
                    styleClass="boton-principal"/>

            <Separator fx:id="sepReabastecer"/>

            <VBox spacing="8">
                <Label text="Reabastecer producto existente" styleClass="etiqueta"/>
                <HBox spacing="10" alignment="CENTER">
                    <TextField fx:id="campoCodigoExistente"
                               promptText="Código"
                               styleClass="campo"
                               maxWidth="Infinity"/>
                    <TextField fx:id="campoCantidadExistente"
                               promptText="Cantidad"
                               styleClass="campo"
                               maxWidth="Infinity"/>
                </HBox>
            </VBox>

            <Button text="REABASTECER STOCK"
                    onAction="#ingresarProductoExistente"
                    maxWidth="Infinity"
                    styleClass="boton-rol"/>

            <Button text="IMPORTAR ENTRADAS CSV"
                    onAction="#importarEntradasDesdeArchivo"
                    maxWidth="Infinity"
                    styleClass="boton-rol"/>

            <Label fx:id="etiquetaAlmacen"
                   text="Almacenero: --"
                   styleClass="texto-secundario"/>

            <Label fx:id="mensaje"
                   text=""
                   wrapText="true"
                   styleClass="mensaje"/>

            <Button text="Cerrar sesión"
                    onAction="#cerrarSesion"
                    maxWidth="Infinity"
                    styleClass="boton-rol"/>
        </VBox>

        <!-- TABLA DERECHA -->
        <VBox alignment="TOP_LEFT" spacing="10"
              HBox.hgrow="1" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="0" right="0" bottom="0" left="0"/>
            </padding>
            <Label text="Inventario actual" styleClass="titulo-formulario"/>

            <ScrollPane fx:id="scrollInventario"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS"
                        prefHeight="500">
                <VBox fx:id="tablaInventario"
                      alignment="TOP_LEFT"
                      spacing="6"
                      VBox.vgrow="ALWAYS"/>
            </ScrollPane>
        </VBox>

    </HBox>

</VBox>
