<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.overbyte.controllers.AlmacenController"
            stylesheets="@../styles/estilos.css" styleClass="app-root">
    <top>
        <HBox styleClass="pos-topbar" alignment="CENTER_LEFT" spacing="14">
            <VBox spacing="2">
                <Label text="TECH-FLOW  /  OPERACIONES" styleClass="topbar-kicker"/>
                <Label text="Centro de almacén" styleClass="page-title"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="etiquetaAlmacen" text="Almacenero: --" styleClass="user-chip"/>
            <Button text="Cerrar sesión" onAction="#cerrarSesion" styleClass="quiet-button"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="14" styleClass="warehouse-workspace">
            <HBox spacing="10" styleClass="warehouse-heading" alignment="CENTER_LEFT">
                <VBox spacing="3">
                    <Label text="CONTROL DE EXISTENCIAS" styleClass="section-kicker"/>
                    <Label text="Inventario y movimientos" styleClass="section-title"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="ENTRADAS · REPOSICIÓN · ALTAS" styleClass="muted-text"/>
            </HBox>

            <SplitPane dividerPositions="0.34" styleClass="warehouse-split" VBox.vgrow="ALWAYS">
                <items>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll">
                        <VBox spacing="12" styleClass="surface-panel">
                            <VBox spacing="4">
                                <Label text="NUEVO REGISTRO" styleClass="section-kicker"/>
                                <Label text="Registrar producto" styleClass="section-title"/>
                                <Label text="Da de alta un artículo en el inventario."
                                       styleClass="muted-text" wrapText="true"/>
                            </VBox>
                            <VBox spacing="5"><Label text="ID PRODUCTO" styleClass="field-label"/><TextField fx:id="campoId" promptText="Ej. PROD-001" styleClass="input-field"/></VBox>
                            <VBox spacing="5"><Label text="NOMBRE" styleClass="field-label"/><TextField fx:id="campoNombre" promptText="Nombre del producto" styleClass="input-field"/></VBox>
                            <HBox spacing="8">
                                <VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="MARCA" styleClass="field-label"/><TextField fx:id="campoMarca" promptText="Marca" styleClass="input-field"/></VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="CATEGORÍA" styleClass="field-label"/><TextField fx:id="campoCategoria" promptText="Categoría" styleClass="input-field"/></VBox>
                            </HBox>
                            <VBox spacing="5"><Label text="DESCRIPCIÓN" styleClass="field-label"/><TextField fx:id="campoDescripcion" promptText="Descripción breve" styleClass="input-field"/></VBox>
                            <GridPane hgap="8" vgap="5">
                                <columnConstraints><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
                                <Label text="PRECIO ENTRADA" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <Label text="PRECIO VENTA" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <TextField fx:id="campoPrecioEntrada" promptText="0.00" styleClass="input-field" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="campoPrecioVenta" promptText="0.00" styleClass="input-field" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                <Label text="STOCK INICIAL" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <TextField fx:id="campoStock" promptText="0" styleClass="input-field" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
                            </GridPane>
                            <Button text="REGISTRAR PRODUCTO" onAction="#ingresarProductoNuevo"
                                    maxWidth="Infinity" styleClass="primary-button"/>
                            <Separator/>
                            <VBox spacing="4">
                                <Label text="REPOSICIÓN" styleClass="section-kicker"/>
                                <Label text="Sumar existencias" styleClass="section-title"/>
                            </VBox>
                            <TextField fx:id="campoCodigoExistente" promptText="Código del producto" styleClass="input-field"/>
                            <TextField fx:id="campoCantidadExistente" promptText="Cantidad a ingresar" styleClass="input-field"/>
                            <Button text="REABASTECER STOCK" onAction="#ingresarProductoExistente"
                                    maxWidth="Infinity" styleClass="secondary-button"/>
                            <Button text="Importar entradas CSV/TXT" onAction="#importarEntradasDesdeArchivo"
                                    maxWidth="Infinity" styleClass="utility-button"/>
                            <Label fx:id="mensaje" text="" wrapText="true" styleClass="status-error"/>
                        </VBox>
                    </ScrollPane>

                    <VBox spacing="12" styleClass="surface-panel">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <VBox spacing="3">
                                <Label text="EXISTENCIAS" styleClass="section-kicker"/>
                                <Label text="Inventario actual" styleClass="section-title"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Stock bajo ≤ 5" styleClass="stock-warning"/>
                        </HBox>
                        <ScrollPane fx:id="scrollInventario" fitToWidth="true"
                                    hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
                                    styleClass="data-scroll" VBox.vgrow="ALWAYS">
                            <VBox fx:id="tablaInventario" spacing="4" styleClass="data-list"/>
                        </ScrollPane>
                    </VBox>
                </items>
            </SplitPane>
        </VBox>
    </center>
</BorderPane>
