<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.overbyte.controllers.AlmacenController"
      alignment="CENTER"
      spacing="20"
      stylesheets="@../styles/estilos.css"
      styleClass="fondo-login">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <VBox alignment="CENTER" spacing="8" styleClass="encabezado">
        <Label text="📦" styleClass="icono-logo"/>
        <Label text="ALMACÉN / INVENTARIO" styleClass="titulo"/>
        <Label text="Sistema de gestión de inventario y ventas"
               styleClass="subtitulo"/>
    </VBox>

    <VBox alignment="CENTER_LEFT"
          spacing="16"
          maxWidth="430"
          styleClass="tarjeta-login">

        <Label text="Registrar producto" styleClass="titulo-formulario"/>
        <Label text="Producto nuevo o reabastecimiento"
               styleClass="texto-secundario"/>

        <VBox spacing="7">
            <Label text="ID producto" styleClass="etiqueta"/>
            <TextField fx:id="campoId"
                       promptText="Ej: PROD-001"
                       styleClass="campo"/>
        </VBox>

        <VBox spacing="7">
            <Label text="Nombre" styleClass="etiqueta"/>
            <TextField fx:id="campoNombre"
                       promptText="Nombre del producto"
                       styleClass="campo"/>
        </VBox>

        <VBox spacing="7">
            <Label text="Marca" styleClass="etiqueta"/>
            <TextField fx:id="campoMarca"
                       promptText="Marca"
                       styleClass="campo"/>
        </VBox>

        <VBox spacing="7">
            <Label text="Categoría" styleClass="etiqueta"/>
            <TextField fx:id="campoCategoria"
                       promptText="Categoría"
                       styleClass="campo"/>
        </VBox>

        <VBox spacing="7">
            <Label text="Descripción" styleClass="etiqueta"/>
            <TextField fx:id="campoDescripcion"
                       promptText="Descripción"
                       styleClass="campo"/>
        </VBox>

        <VBox spacing="7">
            <Label text="Precio entrada" styleClass="etiqueta"/>
            <TextField fx:id="campoPrecioEntrada"
                       promptText="0.00"
                       styleClass="campo"/>
        </VBox>

        <VBox spacing="7">
            <Label text="Precio venta" styleClass="etiqueta"/>
            <TextField fx:id="campoPrecioVenta"
                       promptText="0.00"
                       styleClass="campo"/>
        </VBox>

        <VBox spacing="7">
            <Label text="Stock inicial" styleClass="etiqueta"/>
            <TextField fx:id="campoStock"
                       promptText="0"
                       styleClass="campo"/>
        </VBox>

        <Label fx:id="etiquetaAlmacen"
               text="Almacenero: --"
               styleClass="texto-secundario"/>

        <Label fx:id="mensaje"
               text=""
               wrapText="true"
               styleClass="mensaje"/>

        <Button text="INGRESAR PRODUCTO NUEVO"
                onAction="#ingresarProductoNuevo"
                maxWidth="Infinity"
                styleClass="boton-principal"/>

        <HBox spacing="8" alignment="CENTER">
            <TextField fx:id="campoCodigoExistente"
                       promptText="Código producto"
                       styleClass="campo"
                       maxWidth="Infinity"/>
            <TextField fx:id="campoCantidadExistente"
                       promptText="Cantidad"
                       styleClass="campo"
                       maxWidth="Infinity"/>
        </HBox>

        <Button text="REABASTECER PRODUCTO EXISTENTE"
                onAction="#ingresarProductoExistente"
                maxWidth="Infinity"
                styleClass="boton-rol"/>

        <Button text="Cerrar sesión"
                onAction="#cerrarSesion"
                maxWidth="Infinity"
                styleClass="boton-rol"/>

        <Label text="Acceso seguro · Tech-Flow"
               styleClass="pie-tarjeta"/>
    </VBox>

</VBox>
