<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.overbyte.controllers.VendedorController"
      spacing="0"
      stylesheets="@../styles/estilos.css"
      styleClass="fondo-login">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- ENCABEZADO -->
    <VBox alignment="CENTER_LEFT" spacing="8">
        <Label text="💰" styleClass="icono-logo"/>
        <Label text="PUNTO DE VENTA" styleClass="titulo"/>
        <Label text="Sistema de gestión de inventario y ventas"
               styleClass="subtitulo"/>
    </VBox>

    <HBox spacing="20" alignment="TOP_LEFT" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">

        <!-- PRODUCTOS DISPONIBLES IZQUIERDA -->
        <VBox alignment="TOP_LEFT" spacing="15" maxWidth="460"
              styleClass="tarjeta-login" VBox.vgrow="ALWAYS">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Buscar producto" styleClass="titulo-formulario"/>

            <VBox spacing="8">
                <Label text="Código, nombre o marca" styleClass="etiqueta"/>
                <TextField fx:id="campoBusqueda"
                           promptText="Buscar producto..."
                           styleClass="campo"/>
            </VBox>

            <Button text="BUSCAR"
                    onAction="#buscarProducto"
                    maxWidth="Infinity"
                    styleClass="boton-principal"/>

            <Label text="Productos disponibles" styleClass="etiqueta"/>

            <ScrollPane fx:id="scrollProductos"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS"
                        prefHeight="350">
                <VBox fx:id="tablaProductos"
                      alignment="TOP_LEFT"
                      spacing="6"
                      VBox.vgrow="ALWAYS"/>
            </ScrollPane>
        </VBox>

        <!-- CARRITO DERECHA -->
        <VBox alignment="TOP_LEFT" spacing="15" maxWidth="420"
              styleClass="tarjeta-login" VBox.vgrow="ALWAYS">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Carrito de compra" styleClass="titulo-formulario"/>

            <VBox spacing="8">
                <Label text="Nombre del cliente" styleClass="etiqueta"/>
                <TextField fx:id="campoCliente"
                           promptText="Consumidor final"
                           styleClass="campo"/>
            </VBox>

            <Label text="Items en carrito" styleClass="etiqueta"/>

            <ScrollPane fx:id="scrollCarrito"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS"
                        prefHeight="250">
                <VBox fx:id="tablaCarrito"
                      alignment="TOP_LEFT"
                      spacing="6"
                      VBox.vgrow="ALWAYS"/>
            </ScrollPane>

            <Label fx:id="lblTotalCarrito"
                   text="Total: $0.00"
                   styleClass="titulo-formulario"/>

            <Button text="VENDER CARRITO"
                    onAction="#venderCarrito"
                    maxWidth="Infinity"
                    styleClass="boton-principal"/>

            <Button text="VACIAR CARRITO"
                    onAction="#vaciarCarrito"
                    maxWidth="Infinity"
                    styleClass="boton-rol"/>

            <Separator fx:id="sepOtras"/>

            <Label text="Otras operaciones" styleClass="etiqueta"/>

            <HBox spacing="8" alignment="CENTER">
                <Button text="Eliminar venta"
                        onAction="#eliminarVenta"
                        maxWidth="Infinity"
                        styleClass="boton-rol"/>
                <Button text="Consultar garantía"
                        onAction="#consultarGarantia"
                        maxWidth="Infinity"
                        styleClass="boton-rol"/>
            </HBox>

            <Button text="Importar orden CSV"
                    onAction="#importarOrdenDesdeArchivo"
                    maxWidth="Infinity"
                    styleClass="boton-rol"/>

            <Label fx:id="etiquetaVendedor"
                   text="Vendedor: --"
                   styleClass="texto-secundario"/>

            <Label fx:id="mensaje"
                   text=""
                   wrapText="true"
                   styleClass="mensaje"/>

            <Button text="Cerrar sesión"
                    onAction="#cerrarSesion"
                    maxWidth="Infinity"
                    styleClass="boton-rol"/>
        </VBox>

    </HBox>

</VBox>
