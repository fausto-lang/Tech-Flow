<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.overbyte.controllers.VendedorController"
      stylesheets="@../styles/estilos.css"
      styleClass="main-window">

    <VBox styleClass="sidebar" maxWidth="240" minWidth="220" prefWidth="230">
        <VBox alignment="CENTER" styleClass="logo-container" maxWidth="Infinity">
            <Button styleClass="logo-icon" text="₿"/>
            <Label text="Punto de venta" styleClass="logo-text"/>
        </VBox>
        <VBox spacing="4" styleClass="nav-menu" maxWidth="Infinity">
            <Label text="MENU PRINCIPAL" styleClass="nav-caption"/>
            <Button fx:id="navNuevaVenta" text="Nueva venta" styleClass="nav-button"
                    onAction="#mostrarNuevaVenta" graphicTextGap="13" maxWidth="Infinity">
                <graphic><Label text="＋" styleClass="nav-icon"/></graphic>
            </Button>
            <Button fx:id="navCarrito" text="Carrito" styleClass="nav-button"
                    onAction="#mostrarCarrito" graphicTextGap="13" maxWidth="Infinity">
                <graphic><Label text="▣" styleClass="nav-icon"/></graphic>
            </Button>
        </VBox>
        <Region VBox.vgrow="ALWAYS"/>
        <VBox spacing="8" styleClass="nav-menu" maxWidth="Infinity">
            <Label fx:id="etiquetaVendedor" text="Cajero: --" styleClass="texto-secundario"/>
            <Button fx:id="navCerrarSesion" text="Cerrar sesión"
                    styleClass="nav-button nav-logout" onAction="#cerrarSesion"
                    graphicTextGap="13" maxWidth="Infinity">
                <graphic><Label text="↪" styleClass="nav-icon"/></graphic>
            </Button>
        </VBox>
    </VBox>

    <VBox styleClass="main-content" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" styleClass="header">
            <VBox spacing="3">
                <Label fx:id="lblTituloSeccion" text="Nueva venta" styleClass="header-title"/>
                <Label text="Sistema de gestión de inventario y ventas" styleClass="header-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <VBox spacing="14" styleClass="role-content" VBox.vgrow="ALWAYS">
            <Label fx:id="mensaje" text="" wrapText="true" styleClass="mensaje"/>

            <VBox fx:id="vistaNuevaVenta" spacing="14" VBox.vgrow="ALWAYS">
                <VBox alignment="TOP_LEFT" spacing="12"
                      styleClass="tarjeta-login, tarjeta-compacta, venta-card" VBox.vgrow="ALWAYS">
                    <VBox spacing="4">
                        <Label text="Buscar productos" styleClass="titulo-formulario"/>
                        <Label text="Encuentra por código, nombre o marca y añade unidades al carrito."
                               styleClass="venta-ayuda"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Código, nombre o marca" styleClass="etiqueta"/>
                        <TextField fx:id="campoBusqueda" promptText="Buscar producto..." styleClass="campo"
                                   onAction="#buscarProducto"/>
                    </VBox>
                    <Button text="BUSCAR" onAction="#buscarProducto"
                            maxWidth="Infinity" styleClass="boton-principal boton-buscar-producto"/>
                    <Label text="PRODUCTOS DISPONIBLES" styleClass="venta-subtitulo"/>
                    <ScrollPane fx:id="scrollProductos" styleClass="rejilla lista-venta" fitToWidth="true"
                                hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS"
                                minHeight="320" prefHeight="520">
                        <VBox fx:id="tablaProductos" alignment="TOP_LEFT" spacing="5"
                              styleClass="lista-productos-contenido"/>
                    </ScrollPane>
                </VBox>
            </VBox>

            <VBox fx:id="vistaCarrito" spacing="12" visible="false" managed="false"
                  styleClass="tarjeta-login, tarjeta-compacta, carrito-card" VBox.vgrow="ALWAYS">
                <VBox spacing="4">
                    <Label text="Tu carrito" styleClass="titulo-formulario"/>
                    <Label text="Revisa los productos y elige si deseas confirmar la compra o generar una cotización."
                           styleClass="venta-ayuda"/>
                </VBox>
                <VBox spacing="8" styleClass="comprador-panel">
                    <Label text="Nombre del cliente" styleClass="etiqueta"/>
                    <TextField fx:id="campoCliente" promptText="Nombre obligatorio del comprador" styleClass="campo"/>
                </VBox>
                <Label text="Productos seleccionados" styleClass="venta-subtitulo"/>
                <ScrollPane fx:id="scrollCarrito" styleClass="rejilla lista-carrito" fitToWidth="true"
                            hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS"
                            minHeight="240" prefHeight="480">
                    <VBox fx:id="tablaCarrito" alignment="TOP_LEFT" spacing="5"
                          styleClass="lista-carrito-contenido"/>
                </ScrollPane>
                <Label fx:id="lblTotalCarrito" text="Total: $0.00"
                       styleClass="titulo-formulario, carrito-total"/>
                <HBox spacing="10" styleClass="carrito-acciones">
                    <Button text="CONFIRMAR VENTA" onAction="#confirmarVenta"
                            maxWidth="Infinity" styleClass="boton-principal boton-carrito-confirmar"
                            HBox.hgrow="ALWAYS"/>
                    <Button text="HACER PROFORMA" onAction="#hacerProforma"
                            maxWidth="Infinity" styleClass="boton-exportar boton-carrito-proforma"
                            HBox.hgrow="ALWAYS"/>
                    <Button text="VACIAR CARRITO" onAction="#vaciarCarrito"
                            maxWidth="Infinity" styleClass="boton-rol boton-carrito-vaciar"
                            HBox.hgrow="ALWAYS"/>
                </HBox>
                <Separator/>
                <HBox spacing="8" alignment="CENTER">
                    <Button text="Anular compra o proforma" onAction="#eliminarVenta"
                            maxWidth="Infinity" styleClass="boton-peligro" HBox.hgrow="ALWAYS"/>
                    <Button text="Consultar garantía" onAction="#consultarGarantia"
                            maxWidth="Infinity" styleClass="boton-rol" HBox.hgrow="ALWAYS"/>
                    <Button text="Importar orden CSV" onAction="#importarOrdenDesdeArchivo"
                            maxWidth="Infinity" styleClass="boton-rol" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>
        </VBox>
        <padding><Insets top="22" right="24" bottom="22" left="24"/></padding>
    </VBox>
</HBox>
