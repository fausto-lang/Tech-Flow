<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.overbyte.controllers.VendedorController"
            stylesheets="@../styles/estilos.css" styleClass="app-root">
    <top>
        <HBox styleClass="pos-topbar" alignment="CENTER_LEFT" spacing="14">
            <VBox spacing="2">
                <Label text="TECH-FLOW  /  OPERACIONES" styleClass="topbar-kicker"/>
                <Label text="Punto de venta" styleClass="page-title"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="etiquetaVendedor" text="Vendedor: --" styleClass="user-chip"/>
            <Button text="Cerrar sesión" onAction="#cerrarSesion" styleClass="quiet-button"/>
        </HBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.60" styleClass="pos-split">
            <items>
                <VBox styleClass="surface-panel" spacing="14">
                    <VBox spacing="4">
                        <Label text="CATÁLOGO" styleClass="section-kicker"/>
                        <Label text="Encuentra tus productos" styleClass="section-title"/>
                        <Label text="Busca por código, nombre o marca y agrega unidades al carrito."
                               styleClass="muted-text" wrapText="true"/>
                    </VBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="campoBusqueda" promptText="Buscar producto..."
                                   styleClass="input-field" HBox.hgrow="ALWAYS"
                                   onAction="#buscarProducto"/>
                        <Button text="Buscar" onAction="#buscarProducto" styleClass="primary-button"/>
                    </HBox>
                    <Separator/>
                    <Label text="RESULTADOS" styleClass="field-label"/>
                    <ScrollPane fx:id="scrollProductos" fitToWidth="true"
                                hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
                                styleClass="data-scroll" VBox.vgrow="ALWAYS">
                        <VBox fx:id="tablaProductos" spacing="7" styleClass="data-list"/>
                    </ScrollPane>
                    <Label fx:id="mensaje" text="" wrapText="true" styleClass="status-error"/>
                </VBox>

                <VBox styleClass="cart-panel" spacing="13">
                    <VBox spacing="4">
                        <Label text="VENTA ACTUAL" styleClass="section-kicker"/>
                        <Label text="Carrito" styleClass="section-title"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="CLIENTE" styleClass="field-label"/>
                        <TextField fx:id="campoCliente" promptText="Consumidor final"
                                   styleClass="input-field"/>
                    </VBox>
                    <Separator/>
                    <Label text="PRODUCTOS SELECCIONADOS" styleClass="field-label"/>
                    <ScrollPane fx:id="scrollCarrito" fitToWidth="true"
                                hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
                                styleClass="data-scroll" VBox.vgrow="ALWAYS">
                        <VBox fx:id="tablaCarrito" spacing="7" styleClass="data-list"/>
                    </ScrollPane>
                    <VBox styleClass="total-panel" spacing="5">
                        <Label text="TOTAL A COBRAR" styleClass="field-label"/>
                        <Label fx:id="lblTotalCarrito" text="Total: $0.00" styleClass="total-amount"/>
                    </VBox>
                    <Button text="CONFIRMAR Y COBRAR  →" onAction="#venderCarrito"
                            maxWidth="Infinity" styleClass="primary-button"/>
                    <Button text="Vaciar carrito" onAction="#vaciarCarrito"
                            maxWidth="Infinity" styleClass="quiet-button"/>
                    <Separator/>
                    <Label text="OTRAS OPERACIONES" styleClass="field-label"/>
                    <GridPane hgap="7" vgap="7">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                        </columnConstraints>
                        <Button text="Anular venta" onAction="#eliminarVenta" maxWidth="Infinity"
                                styleClass="utility-button" GridPane.columnIndex="0"/>
                        <Button text="Consultar garantía" onAction="#consultarGarantia" maxWidth="Infinity"
                                styleClass="utility-button" GridPane.columnIndex="1"/>
                        <Button text="Importar orden" onAction="#importarOrdenDesdeArchivo"
                                maxWidth="Infinity" styleClass="utility-button"
                                GridPane.columnIndex="0" GridPane.columnSpan="2"/>
                    </GridPane>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>
