<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox styleClass="main-window"
      stylesheets="@../styles/estilos.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.overbyte.controllers.AdminController">

    <!-- BARRA LATERAL -->
    <VBox styleClass="sidebar">

        <VBox alignment="CENTER" styleClass="logo-container">
            <Button styleClass="logo-icon" text="🏪"/>
            <Label styleClass="logo-text" text="Over-Byte"/>
        </VBox>

        <VBox styleClass="nav-menu" spacing="8">
            <Button styleClass="nav-button"
                    text="Caja"
                    onAction="#mostrarCaja"
                    maxWidth="Infinity"/>

            <Button styleClass="nav-button"
                    text="Inventario"
                    onAction="#mostrarInventario"
                    maxWidth="Infinity"/>

            <Button styleClass="nav-button"
                    text="Ventas"
                    onAction="#mostrarVentas"
                    maxWidth="Infinity"/>

            <Button styleClass="nav-button"
                    text="Empleados"
                    onAction="#mostrarEmpleados"
                    maxWidth="Infinity"/>

            <Button styleClass="nav-button"
                    text="Productos"
                    onAction="#mostrarProductos"
                    maxWidth="Infinity"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <Button styleClass="nav-button"
                text="Cerrar sesión"
                onAction="#cerrarSesion"
                maxWidth="Infinity"/>

        <padding>
            <Insets top="20" right="15" bottom="20" left="15"/>
        </padding>
    </VBox>

    <!-- CONTENIDO PRINCIPAL -->
    <VBox styleClass="main-content" HBox.hgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" styleClass="header">
            <Label fx:id="lblTituloSeccion"
                   styleClass="header-title"
                   text="Caja"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <VBox fx:id="contenidoCentro"
              HBox.hgrow="ALWAYS"
              VBox.vgrow="ALWAYS"/>

        <padding>
            <Insets top="25" right="25" bottom="25" left="25"/>
        </padding>
    </VBox>

</HBox>
