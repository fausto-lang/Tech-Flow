<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox styleClass="main-window"
      stylesheets="@../styles/estilos.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.overbyte.controllers.AdminController">

    <!-- Barra lateral -->
    <VBox styleClass="sidebar" maxWidth="240" minWidth="220" prefWidth="230">
        <VBox alignment="CENTER" styleClass="logo-container" maxWidth="Infinity">
            <Button styleClass="logo-icon" text="&#127968;"/>
            <Label styleClass="logo-text" text="Over-Byte"/>
        </VBox>
        <VBox styleClass="nav-menu" spacing="4" maxWidth="Infinity">
            <Label text="MENU PRINCIPAL" styleClass="nav-caption"/>
            <Button fx:id="navCaja" styleClass="nav-button" text="Caja"
                    accessibleText="Abrir la gestión de caja" onAction="#mostrarCaja"
                    graphicTextGap="13" maxWidth="Infinity">
                <graphic><Label text="▣" styleClass="nav-icon"/></graphic>
            </Button>
            <Button fx:id="navInventario" styleClass="nav-button" text="Inventario"
                    accessibleText="Mostrar inventario" onAction="#mostrarInventario"
                    graphicTextGap="13" maxWidth="Infinity">
                <graphic><Label text="▦" styleClass="nav-icon"/></graphic>
            </Button>
            <Button fx:id="navVentas" styleClass="nav-button" text="Ventas"
                    accessibleText="Mostrar ventas" onAction="#mostrarVentas"
                    graphicTextGap="13" maxWidth="Infinity">
                <graphic><Label text="↗" styleClass="nav-icon"/></graphic>
            </Button>
            <Button fx:id="navEmpleados" styleClass="nav-button" text="Empleados"
                    accessibleText="Mostrar empleados" onAction="#mostrarEmpleados"
                    graphicTextGap="13" maxWidth="Infinity">
                <graphic><Label text="♙" styleClass="nav-icon"/></graphic>
            </Button>
            <Button fx:id="navProductos" styleClass="nav-button" text="Productos"
                    accessibleText="Mostrar productos" onAction="#mostrarProductos"
                    graphicTextGap="13" maxWidth="Infinity">
                <graphic><Label text="◇" styleClass="nav-icon"/></graphic>
            </Button>
            <Button fx:id="navProveedores" styleClass="nav-button" text="Proveedores"
                    accessibleText="Mostrar proveedores" onAction="#mostrarProveedores"
                    graphicTextGap="13" maxWidth="Infinity">
                <graphic><Label text="▤" styleClass="nav-icon"/></graphic>
            </Button>
        </VBox>
        <Region VBox.vgrow="ALWAYS"/>
        <VBox styleClass="nav-menu" maxWidth="Infinity">
            <Button fx:id="navCerrarSesion" styleClass="nav-button nav-logout"
                    text="Cerrar sesión" onAction="#cerrarSesion"
                    graphicTextGap="13" maxWidth="Infinity">
                <graphic><Label text="↪" styleClass="nav-icon"/></graphic>
            </Button>
        </VBox>
    </VBox>

    <!-- Contenido principal -->
    <VBox styleClass="main-content" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" styleClass="header">
            <Label fx:id="lblTituloSeccion" styleClass="header-title" text="Caja"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
        <VBox fx:id="contenidoCentro" styleClass="contenido-centro" VBox.vgrow="ALWAYS" prefHeight="550" minHeight="450"/>
    </VBox>
</HBox>
