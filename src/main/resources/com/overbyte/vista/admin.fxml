<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox styleClass="main-window"
      stylesheets="@../styles/estilos.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.overbyte.controllers.AdminController">

    <!-- Barra lateral -->
    <VBox styleClass="sidebar" maxWidth="220" minWidth="200">
        <VBox alignment="CENTER" styleClass="logo-container" maxWidth="Infinity">
            <Button styleClass="logo-icon" text="&#127968;"/>
            <Label styleClass="logo-text" text="Over-Byte"/>
        </VBox>
        <VBox styleClass="nav-menu" spacing="4" maxWidth="Infinity">
            <Button fx:id="navCaja" styleClass="nav-button" text="Caja" onAction="#mostrarCaja" maxWidth="Infinity"/>
            <Button fx:id="navInventario" styleClass="nav-button" text="Inventario" onAction="#mostrarInventario" maxWidth="Infinity"/>
            <Button fx:id="navVentas" styleClass="nav-button" text="Ventas" onAction="#mostrarVentas" maxWidth="Infinity"/>
            <Button fx:id="navEmpleados" styleClass="nav-button" text="Empleados" onAction="#mostrarEmpleados" maxWidth="Infinity"/>
            <Button fx:id="navProductos" styleClass="nav-button" text="Productos" onAction="#mostrarProductos" maxWidth="Infinity"/>
            <Button fx:id="navProveedores" styleClass="nav-button" text="Proveedores" onAction="#mostrarProveedores" maxWidth="Infinity"/>
        </VBox>
        <Region VBox.vgrow="ALWAYS"/>
        <VBox styleClass="nav-menu" maxWidth="Infinity">
            <Button styleClass="nav-button" text="Cerrar sesion" onAction="#cerrarSesion" maxWidth="Infinity"/>
        </VBox>
    </VBox>

    <!-- Contenido principal -->
    <VBox styleClass="main-content" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" styleClass="header">
            <Label fx:id="lblTituloSeccion" styleClass="header-title" text="Caja"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
        <VBox fx:id="contenidoCentro" styleClass="contenido-centro" VBox.vgrow="ALWAYS" prefHeight="550" minHeight="450"/>
    </VBox>
</HBox>
