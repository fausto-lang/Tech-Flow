<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.overbyte.controllers.LoginController"
           stylesheets="@../styles/estilos.css"
           styleClass="login-root">
    <HBox styleClass="login-shell" maxWidth="1040" maxHeight="650">
        <VBox styleClass="login-brand" alignment="CENTER_LEFT" spacing="18"
              HBox.hgrow="ALWAYS">
            <Label text="✦" styleClass="brand-mark"/>
            <VBox spacing="4">
                <Label text="TECH-FLOW" styleClass="brand-title"/>
                <Label text="CONTROL • INVENTARIO • VENTAS" styleClass="brand-kicker"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Una plataforma para mantener
cada operación bajo control."
                   styleClass="brand-copy" wrapText="true"/>
            <Label text="OVER-BYTE  /  GESTIÓN COMERCIAL" styleClass="brand-foot"/>
        </VBox>

        <VBox styleClass="login-form-panel" alignment="CENTER_LEFT" spacing="19"
              prefWidth="440" minWidth="360">
            <VBox spacing="6">
                <Label text="Bienvenido de nuevo" styleClass="form-heading"/>
                <Label text="Inicia sesión para acceder a tu espacio de trabajo."
                       styleClass="form-subheading" wrapText="true"/>
            </VBox>

            <VBox spacing="7">
                <Label text="USUARIO" styleClass="field-label"/>
                <TextField fx:id="campoNombre" promptText="Tu nombre de usuario"
                           styleClass="input-field"/>
            </VBox>

            <VBox spacing="9">
                <Label text="TIPO DE ACCESO" styleClass="field-label"/>
                <HBox spacing="7">
                    <Button fx:id="btnAdministrador" text="Admin" onAction="#seleccionarAdministrador"
                            styleClass="role-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnCajero" text="Cajero" onAction="#seleccionarCajero"
                            styleClass="role-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnAlmacen" text="Almacén" onAction="#seleccionarAlmacen"
                            styleClass="role-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label fx:id="etiquetaRol" text="Selecciona el perfil correspondiente"
                       styleClass="muted-text"/>
            </VBox>

            <VBox spacing="7">
                <Label text="CONTRASEÑA" styleClass="field-label"/>
                <PasswordField fx:id="campoContrasena" promptText="Introduce tu contraseña"
                               styleClass="input-field"/>
            </VBox>

            <Label fx:id="mensaje" text="" wrapText="true" styleClass="status-error"/>
            <Button text="ENTRAR AL SISTEMA  →" onAction="#iniciarSesion"
                    maxWidth="Infinity" styleClass="primary-button"/>
            <Label text="Acceso interno · Tech-Flow" styleClass="form-foot"/>
        </VBox>
    </HBox>
</StackPane>
